# Copy to .env. Never commit real secrets.
# Generate a key: .venv/bin/python -c "import secrets; print(secrets.token_urlsafe(64))"
DJANGO_SECRET_KEY=
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1,[::1]

# Required to send chat messages; optional for accounts and expense lists.
GEMINI_API_KEY=
GEMINI_MODEL=
# Local development REPL only; never selects the web user's identity.
USER_ID=
